---
import { handleBackground } from './layoutHelper';

const { frontmatter } = Astro.props;
const style = handleBackground(frontmatter.background, frontmatter.backgroundDim);
---

<div class="slidev-layout end bg-black text-white text-xl tracking-widest text-center grid place-content-center h-full select-none" style={style}>
  <div class="my-auto">
    <slot>END</slot>
  </div>
</div>
