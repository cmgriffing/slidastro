---
import { handleBackground } from './layoutHelper';

const { frontmatter } = Astro.props;
const style = handleBackground(frontmatter.background, frontmatter.backgroundDim);
---

<div class="slidev-layout two-columns w-full h-full grid grid-cols-2 gap-8" style={style}>
  <div class="col-left">
    <slot />
    <slot name="left" />
  </div>
  <div class="col-right">
    <slot name="right" />
  </div>
</div>
