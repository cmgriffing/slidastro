---
import { handleBackground } from './layoutHelper';

const { frontmatter } = Astro.props;
const style = handleBackground(frontmatter.background, frontmatter.backgroundDim);
---

<div class="slidev-layout cover flex flex-col justify-center items-center text-center h-full" style={style}>
  <div class="my-auto">
    <slot />
  </div>
</div>
