---
interface Props {
  width: number;
  height: number;
}

const { width, height } = Astro.props;
---

<div class="slide-container" style={`width: ${width}px; height: ${height}px;`}>
  <div class="slide-content" id="slide-content-wrapper">
    <slot />
  </div>
</div>

<style>
  .slide-container {
    position: relative;
    overflow: hidden;
    background: white;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  }
  .slide-content {
    width: 100%;
    height: 100%;
    transform-origin: top left;
  }
</style>
