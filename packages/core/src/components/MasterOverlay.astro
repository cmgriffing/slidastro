---
import DrawingToolbar from './DrawingToolbar.astro';
import ThemeToggle from './ThemeToggle.astro';
import NavigationOverlay from './NavigationOverlay.astro';
import MasterDashboard from './MasterDashboard.astro';

const { slideNo } = Astro.props;
---

<div id="master-overlay" class="master-overlay">
  <div class="ui-layer" id="layer-drawing" data-show="false">
    <DrawingToolbar />
  </div>
  
  <div class="ui-layer" id="layer-theme" data-show="false">
    <ThemeToggle />
  </div>

  <div class="ui-layer" id="layer-help" data-show="false">
    <MasterDashboard />
  </div>

  <NavigationOverlay slideNo={slideNo} />
</div>

<style>
  .master-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1000;
  }

  .ui-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ui-layer :global(*) {
    pointer-events: auto;
  }

  /* Drawing: Slide up from bottom */
  #layer-drawing[data-show="false"] {
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
  }
  #layer-drawing[data-show="true"] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Theme: Slide in from top-right */
  #layer-theme[data-show="false"] {
    opacity: 0;
    visibility: hidden;
    transform: translate(20px, -20px);
  }
  #layer-theme[data-show="true"] {
    opacity: 1;
    visibility: visible;
    transform: translate(0, 0);
  }

  /* Help: Scale in from center */
  #layer-help[data-show="false"] {
    opacity: 0;
    visibility: hidden;
    transform: scale(0.9);
  }
  #layer-help[data-show="true"] {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
  }
</style>

<script>
  import { $ui, toggleUI, setLayer } from '@slidastro/client';
  import { next, prev, goToSlide, totalPages } from './Navigation.client';
  import { navigate } from 'astro:transitions/client';

  // 1. Detect layer from URL
  const isPresenter = window.location.pathname.startsWith('/presenter');
  setLayer(isPresenter ? 'presenter' : 'audience');

  // 2. Subscribe to UI state
  const drawingLayer = document.getElementById('layer-drawing');
  const themeLayer = document.getElementById('layer-theme');
  const helpLayer = document.getElementById('layer-help');

  $ui.subscribe((state) => {
    if (drawingLayer) {
      drawingLayer.setAttribute('data-show', state.showDrawing ? 'true' : 'false');
    }
    if (themeLayer) {
      themeLayer.setAttribute('data-show', state.showTheme ? 'true' : 'false');
    }
    if (helpLayer) {
      helpLayer.setAttribute('data-show', state.showHelp ? 'true' : 'false');
    }
  });

  // 3. Centralized keyboard shortcuts
  window.addEventListener('keydown', (e) => {
    // Ignore if typing in an input/textarea
    if (['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement)?.tagName) || (e.target as HTMLElement).closest('[contenteditable]')) return;

    const key = e.key.toLowerCase();

    // Tools
    if (key === 'd') {
      toggleUI('showDrawing');
      return;
    }
    if (key === 't') {
      toggleUI('showTheme');
      return;
    }
    if (key === 'n') {
      toggleUI('showNavigation');
      return;
    }
    if (key === 'h' || e.key === '?') {
      toggleUI('showHelp');
      return;
    }
    if (key === 'f') {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen();
      } else if (document.exitFullscreen) {
        document.exitFullscreen();
      }
      return;
    }
    if (key === 'o' || key === 'g') {
      navigate('/overview');
      return;
    }

    // Navigation
    if (['arrowright', 'arrowdown', ' ', 'pagedown', 'enter'].includes(key)) {
      e.preventDefault();
      next();
    } else if (['arrowleft', 'arrowup', 'backspace', 'pageup'].includes(key)) {
      e.preventDefault();
      prev();
    } else if (key === 'home') {
      e.preventDefault();
      goToSlide(1);
    } else if (key === 'end') {
      e.preventDefault();
      goToSlide(totalPages);
    }
  });
</script>
