---
import slidesData from 'virtual:slidastro/slides';
import PresenterLayout from '../components/PresenterLayout.astro';
import SlidePreview from '../components/SlidePreview.astro';
import PresenterTimer from '../components/PresenterTimer.astro';
import PresenterClock from '../components/PresenterClock.astro';
import MasterOverlay from '../components/MasterOverlay.astro';

export async function getStaticPaths() {
  return Array.from({ length: slidesData.slides.length }, (_, i) => ({
    params: { no: (i + 1).toString() },
  }));
}

const { no } = Astro.params;
const slideNo = parseInt(no || '1', 10);
const slide = slidesData.slides[slideNo - 1];

if (!slide) {
  return Astro.redirect('/presenter/1');
}

const nextSlideIndex = slideNo < slidesData.slides.length ? slideNo : null;

// Scales for previews
const mainScale = 0.6;
const nextScale = 0.35;
---

<PresenterLayout>
  <div class="flex flex-col h-screen bg-[#121212] text-gray-200 overflow-hidden font-sans">
    <!-- Top Bar -->
    <header class="flex items-center justify-between px-4 py-2 bg-[#1a1a1a] border-b border-[#333] z-10 shadow-md">
      <div class="flex items-center gap-6">
        <PresenterTimer />
        <PresenterClock />
      </div>
      
      <div class="flex items-center gap-8">
        <div class="flex flex-col items-center">
          <span class="text-[10px] uppercase font-bold text-gray-500">Slide</span>
          <span class="font-mono text-lg font-bold">{slideNo} / {slidesData.slides.length}</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-[10px] uppercase font-bold text-gray-500">Clicks</span>
          <span id="clicks-display" class="font-mono text-lg font-bold text-orange-400">0 / 0</span>
        </div>
      </div>

      <div class="flex gap-2">
         <button id="prev-btn" class="bg-gray-800 hover:bg-gray-700 px-3 py-1 rounded cursor-pointer transition-colors text-sm font-bold" title="Previous Slide">
           &lt;
         </button>
         <button id="next-btn" class="bg-gray-800 hover:bg-gray-700 px-3 py-1 rounded cursor-pointer transition-colors text-sm font-bold" title="Next Slide">
           &gt;
         </button>
      </div>
    </header>

    <!-- Main Content Grid -->
    <main class="flex-1 grid grid-cols-[1fr_380px] overflow-hidden">
      <!-- Left: Current Slide -->
      <section class="relative flex items-center justify-center p-8 bg-[#000]">
         <div class="shadow-2xl border border-[#222] bg-white">
           <SlidePreview index={slideNo - 1} scale={mainScale} />
         </div>
         <div class="absolute top-4 left-4 text-[10px] uppercase font-bold text-gray-600 tracking-widest pointer-events-none">Current Slide</div>
      </section>

      <!-- Right: Sidebar -->
      <aside class="flex flex-col border-l border-[#333] bg-[#1a1a1a] overflow-hidden">
        <!-- Sidebar Top: Next Slide -->
        <div class="p-4 border-b border-[#333]">
          <div class="text-[10px] uppercase font-bold text-gray-500 mb-2 tracking-widest">Next Slide</div>
          <div class="flex justify-center bg-black p-2 border border-[#222] min-h-[180px]">
            {nextSlideIndex !== null ? (
              <SlidePreview index={nextSlideIndex} scale={nextScale} />
            ) : (
              <div class="flex items-center justify-center text-gray-600 italic text-sm">End of presentation</div>
            )}
          </div>
        </div>

        <!-- Sidebar Bottom: Notes -->
        <div class="flex-1 flex flex-col overflow-hidden">
          <div class="px-4 py-2 border-b border-[#222] flex justify-between items-center bg-[#222]">
             <span class="text-[10px] uppercase font-bold text-gray-500 tracking-widest">Speaker Notes</span>
          </div>
          <div class="flex-1 overflow-y-auto p-4 prose prose-invert max-w-none scrollbar-thin scrollbar-thumb-gray-700 scrollbar-track-transparent">
             <div id="notes-content" set:html={slide.noteHTML || '<p class="text-gray-500 italic">No notes for this slide.</p>'} />
          </div>
        </div>
      </aside>
    </main>
  </div>

  <MasterOverlay slideNo={slideNo} />

  <script>
    import { initPresenterNavigation } from '../components/PresenterNavigation.client';
    // @ts-ignore
    import slidesData from 'virtual:slidastro/slides';
    import { $nav } from '@slidastro/client';
    
    let unsubscribe: () => void;

    function setup() {
      initPresenterNavigation(slidesData.slides.length);
      
      const clicksDisplay = document.getElementById('clicks-display');

      if (unsubscribe) unsubscribe();

      // Update clicks display
      unsubscribe = $nav.subscribe((state) => {
        if (clicksDisplay) {
          clicksDisplay.textContent = `${state.click} / ${state.totalClicks}`;
        }
      });
    }

    setup();
    document.addEventListener('astro:after-swap', setup);
  </script>

  <style is:global>
    /* UnoCSS Propose Typography Fixes for Sidebar */
    #notes-content p {
      margin-top: 0.5rem;
      margin-bottom: 0.5rem;
    }
    #notes-content h1, #notes-content h2, #notes-content h3 {
      margin-top: 1rem;
      margin-bottom: 0.5rem;
      color: #60a5fa;
    }
    
    /* Scrollbar */
    .scrollbar-thin::-webkit-scrollbar {
      width: 6px;
    }
    .scrollbar-thumb-gray-700::-webkit-scrollbar-thumb {
      background-color: #374151;
      border-radius: 3px;
    }
    .scrollbar-track-transparent::-webkit-scrollbar-track {
      background-color: transparent;
    }
  </style>
</PresenterLayout>
