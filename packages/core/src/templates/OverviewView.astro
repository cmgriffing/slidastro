---
import { ClientRouter } from 'astro:transitions';
import slidesData from 'virtual:slidastro/slides';
import SlideContainer from '../components/SlideContainer.astro';

const { canvasWidth, canvasHeight } = slidesData.config;
const scale = 0.25; // Scale for overview thumbnails

// Function to resolve slide content components for each slide
const resolveSlideContent = async (slide: any) => {
  if (slide.virtualId) {
    const module = await import(/* @vite-ignore */ slide.virtualId);
    return module.default;
  }
  return null;
};

// Pre-resolve all content for the slides
const slidesWithContent = await Promise.all(
  slidesData.slides.map(async (slide) => ({
    ...slide,
    SlideContent: await resolveSlideContent(slide),
  }))
);
---

<html>
<head>
  <meta charset="UTF-8">
  <title>{slidesData.config.title} - Overview</title>
  <style>
    body {
      margin: 0;
      padding: 40px;
      background-color: #222;
      color: white;
      font-family: sans-serif;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 40px;
    }
    .slide-item {
      cursor: pointer;
      transition: transform 0.2s ease;
      text-decoration: none;
      color: inherit;
    }
    .slide-item:hover {
      transform: scale(1.05);
    }
    .slide-item:hover .slide-container {
      outline: 4px solid #4ade80;
    }
    .thumbnail-container {
      position: relative;
      /* Fixed size for the thumbnail area based on aspect ratio */
      width: 100%;
      aspect-ratio: var(--aspect-ratio);
      overflow: hidden;
      background: white;
    }
    .thumbnail-content {
      transform: scale(var(--scale));
      transform-origin: top left;
      width: var(--width);
      height: var(--height);
      pointer-events: none; /* Disable interaction in overview */
    }
    .slide-number {
      margin-top: 10px;
      text-align: center;
      font-size: 0.9rem;
      opacity: 0.7;
    }
  </style>
  <ClientRouter />
</head>
<body>
  <h1>Overview</h1>
  <div class="grid" style={`--aspect-ratio: ${slidesData.config.aspectRatio};`}>
    {slidesWithContent.map((slide, i) => (
      <a href={`/${i + 1}`} class="slide-item">
        <div class="thumbnail-container">
          <div class="thumbnail-content" style={`--scale: ${250 / canvasWidth}; --width: ${canvasWidth}px; --height: ${canvasHeight}px;`}>
             {slide.SlideContent ? <slide.SlideContent /> : <div set:html={slide.contentHTML} class="content-wrapper" />}
          </div>
        </div>
        <div class="slide-number">{i + 1}</div>
      </a>
    ))}
  </div>
  
  <style is:global>
    /* Ensure content inside thumbnails is styled correctly but smaller */
    .thumbnail-content .content-wrapper {
      padding: 40px;
      font-size: 1.5rem;
      line-height: 1.6;
      height: 100%;
      box-sizing: border-box;
      color: black;
    }
  </style>
</body>
</html>
