---
import slidesData from 'virtual:slidastro/slides';

const { no } = Astro.params;
const slideNo = parseInt(no || '1', 10);
const slide = slidesData.slides[slideNo - 1];

if (!slide) {
  return Astro.redirect('/1');
}
---

<html>
<head>
  <title>{slidesData.config.title} - Slide {slideNo}</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #f0f0f0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .slide {
      width: 980px;
      height: 551px;
      background: white;
      padding: 40px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .content {
      flex: 1;
      font-size: 1.5rem;
      line-height: 1.6;
    }
    .page-number {
      position: absolute;
      bottom: 20px;
      right: 20px;
      font-size: 0.8rem;
      color: #888;
    }
    pre {
      background: #f6f8fa;
      padding: 16px;
      border-radius: 6px;
      overflow: auto;
    }
  </style>
</head>
<body>
  <div class="slide">
    <div class="content">
      {/* For Phase 1, we just render the content as-is. 
          If it's markdown, it will show as raw text. 
          If we had a renderer, we'd use set:html={renderMarkdown(slide.contentRaw)} */}
      <pre>{slide.contentRaw}</pre>
    </div>
    <div class="page-number">
      {slideNo} / {slidesData.slides.length}
    </div>
  </div>
</body>
</html>
