---
import { ClientRouter } from 'astro:transitions';
import slidesData from 'virtual:slidastro/slides';
import SlideContainer from '../components/SlideContainer.astro';
import MasterOverlay from '../components/MasterOverlay.astro';
import DefaultLayout from '../layouts/default.astro';
import CoverLayout from '../layouts/cover.astro';
import TwoColsLayout from '../layouts/two-cols.astro';
import CenterLayout from '../layouts/center.astro';
import FactLayout from '../layouts/fact.astro';
import QuoteLayout from '../layouts/quote.astro';
import StatementLayout from '../layouts/statement.astro';
import SectionLayout from '../layouts/section.astro';
import EndLayout from '../layouts/end.astro';
import ImageLayout from '../layouts/image.astro';
import ImageLeftLayout from '../layouts/image-left.astro';
import ImageRightLayout from '../layouts/image-right.astro';
import IframeLayout from '../layouts/iframe.astro';
import IframeLeftLayout from '../layouts/iframe-left.astro';
import IframeRightLayout from '../layouts/iframe-right.astro';
import '../styles/layouts-base.css';

export async function getStaticPaths() {
  return Array.from({ length: slidesData.slides.length }, (_, i) => ({
    params: { no: (i + 1).toString() },
  }));
}

const { no } = Astro.params;
const slideNo = parseInt(no || '1', 10);
const slide = slidesData.slides[slideNo - 1];

if (!slide) {
  return Astro.redirect('/1');
}

let SlideContent: any;
if (slide.virtualId) {
  const module = await import(/* @vite-ignore */ slide.virtualId);
  SlideContent = module.default;
}

const { canvasWidth, canvasHeight } = slidesData.config;

const builtinLayouts: Record<string, any> = {
  default: DefaultLayout,
  cover: CoverLayout,
  'two-cols': TwoColsLayout,
  center: CenterLayout,
  fact: FactLayout,
  quote: QuoteLayout,
  statement: StatementLayout,
  section: SectionLayout,
  end: EndLayout,
  image: ImageLayout,
  'image-left': ImageLeftLayout,
  'image-right': ImageRightLayout,
  iframe: IframeLayout,
  'iframe-left': IframeLeftLayout,
  'iframe-right': IframeRightLayout,
};

const layoutName = slide.frontmatter.layout || 'default';
let Layout = builtinLayouts[layoutName] || builtinLayouts.default;

if (slidesData.layoutsMap[layoutName]) {
  const module = await import(/* @vite-ignore */ slidesData.layoutsMap[layoutName]);
  Layout = module.default;
}

const slotEntries = Object.entries(slide.slots || {}).filter(([name]) => name !== 'default');
---

<html>
<head>
  <meta charset="UTF-8">
  <title>{slidesData.config.title} - Slide {slideNo}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
  {slidesData.config.themeCSS && <link rel="stylesheet" href={`/@fs${slidesData.config.themeCSS}`}>}
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #050505;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      height: 100vh;
      width: 100vw;
    }
    .stage {
      background: radial-gradient(circle, #222 0%, #050505 100%);
      flex: 1;
      height: 100%;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .content-wrapper {
      height: 100%;
      box-sizing: border-box;
    }
    :global(.slidastro-click) {
      transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    :global(.slidastro-click-hidden) {
      opacity: 0;
      visibility: hidden;
    }
  </style>
  <ClientRouter />
</head>
<body>
  <div class="stage">
    <SlideContainer width={canvasWidth} height={canvasHeight}>
      <div class="content-wrapper" id="slide-content" data-index={slideNo - 1} transition:name="slide-content" transition:animate="fade">
        <Layout frontmatter={slide.frontmatter}>
          {SlideContent ? <SlideContent /> : <div set:html={slide.contentHTML} />}
          {slide.slots?.right && <div slot="right" set:html={slide.slots.right} />}
          {slide.slots?.left && <div slot="left" set:html={slide.slots.left} />}
          {slide.slots?.top && <div slot="top" set:html={slide.slots.top} />}
          {slide.slots?.bottom && <div slot="bottom" set:html={slide.slots.bottom} />}
        </Layout>
      </div>
    </SlideContainer>
  </div>

  <MasterOverlay slideNo={slideNo} />

  <script>
    import { initTheme } from '../components/Theme.client';
    import { initSlideScale } from '../components/SlideScale.client';
    import { initNavigation } from '../components/Navigation.client';
    import { initMermaid } from '../components/Mermaid.client';
    import { initMonaco } from '../components/Monaco.client';
    import { initDrauu } from '../components/Drauu.client';
    import { initAutoFitText } from '../components/SAutoFitText.client';
    // @ts-ignore
    import slidesData from 'virtual:slidastro/slides';
    
    const { canvasWidth, canvasHeight } = slidesData.config;
    const slideNo = parseInt(window.location.pathname.split('/').pop() || '1', 10);

    initTheme();
    initSlideScale(canvasWidth, canvasHeight);
    initNavigation(slidesData.slides.length);
    initMermaid();
    initMonaco();
    initDrauu(slideNo - 1);
    initAutoFitText();

    document.addEventListener('astro:after-swap', () => {
      const newSlideNo = parseInt(window.location.pathname.split('/').pop() || '1', 10);
      initTheme();
      initSlideScale(canvasWidth, canvasHeight);
      initNavigation(slidesData.slides.length);
      initMermaid();
      initMonaco();
      initDrauu(newSlideNo - 1);
      initAutoFitText();
    });

    if (import.meta.hot) {
      import.meta.hot.on('slidastro:update-content', ({ updates }) => {
        const contentEl = document.getElementById('slide-content');
        if (!contentEl) return;
        
        const currentIndex = parseInt(contentEl.getAttribute('data-index') || '-1', 10);
        // @ts-ignore
        const update = updates.find(u => u.index === currentIndex);
        
        if (update) {
          window.location.reload();
        }
      });
    }
  </script>
</body>
</html>
