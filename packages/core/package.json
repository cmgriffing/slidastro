{
  "name": "@slidastro/core",
  "version": "0.0.1",
  "private": true,
  "description": "The core engine for Slidastro",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts && cp -r src/components src/layouts src/templates src/styles src/utils dist/",
    "dev": "tsdown src/index.ts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@astro-community/astro-embed-twitter": "^0.5.11",
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/mdx": "^5.0.3",
    "@mdit/plugin-katex": "^0.25.2",
    "@shikijs/markdown-it": "^4.0.2",
    "@shikijs/monaco": "^4.0.2",
    "@slidastro/client": "workspace:*",
    "@slidastro/parser": "workspace:*",
    "@slidastro/types": "workspace:*",
    "@typescript/ata": "^0.9.8",
    "@unocss/astro": "^66.6.8",
    "@unocss/reset": "^66.6.8",
    "@vueuse/core": "^14.2.1",
    "astro": "^5.18.1",
    "drauu": "^1.0.0",
    "katex": "^0.16.45",
    "lz-string": "^1.5.0",
    "magic-string": "^0.30.17",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.14.0",
    "monaco-editor": "^0.55.1",
    "rough-notation": "^0.5.1",
    "shiki": "^4.0.2",
    "shiki-magic-move": "^1.3.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@unocss/preset-attributify": "^66.6.8",
    "@unocss/preset-typography": "^66.6.8",
    "@unocss/preset-wind3": "^66.6.8",
    "@unocss/transformer-directives": "^66.6.8",
    "@unocss/transformer-variant-group": "^66.6.8",
    "rehype": "^13.0.2",
    "tsdown": "^0.3.0",
    "typescript": "^5.9.3",
    "unocss": "^66.6.8",
    "vitest": "^1.5.0"
  }
}
