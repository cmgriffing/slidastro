{
  "name": "@slidastro/core",
  "version": "0.0.1",
  "private": true,
  "description": "The core engine for Slidastro",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts && cp -r src/components src/layouts src/templates dist/",
    "dev": "tsdown src/index.ts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@mdit/plugin-katex": "^0.25.2",
    "@shikijs/markdown-it": "^4.0.2",
    "@slidastro/client": "workspace:*",
    "@slidastro/parser": "workspace:*",
    "@slidastro/types": "workspace:*",
    "@unocss/astro": "^66.6.8",
    "@unocss/reset": "^66.6.8",
    "astro": "^4.6.1",
    "katex": "^0.16.45",
    "markdown-it": "^14.1.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "tsdown": "^0.3.0",
    "typescript": "^5.4.4",
    "vitest": "^1.5.0"
  }
}
